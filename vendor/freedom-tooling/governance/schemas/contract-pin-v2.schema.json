{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freetwai.com/contracts/governance/contract-pin-v2/v1",
  "title": "Freedom contract-pin-v2 development schema",
  "type": "object",
  "properties": {
    "format": {
      "const": "freedom.contract-pin/v2"
    },
    "source_repository": {
      "enum": ["FreeTWAI/freedom-platform", "FreeTWAI-AI/freedom-platform"]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "release_set": {
      "type": "object",
      "properties": {
        "path": {
          "const": "release-set.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "properties": {
        "path": {
          "const": "release-set.proof.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[-a-zA-Z0-9_./]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000000
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1024
    }
  },
  "required": [
    "format",
    "source_repository",
    "source_commit",
    "release_set",
    "proof",
    "profiles",
    "artifacts"
  ],
  "additionalProperties": false
}

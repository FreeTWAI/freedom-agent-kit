{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freetwai.com/contracts/governance/module/v1",
  "title": "Freedom module development schema",
  "type": "object",
  "properties": {
    "format": {
      "const": "freedom.module/v1"
    },
    "module_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
    },
    "owner_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
    },
    "owned_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[-a-zA-Z0-9_./*]+$"
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "public_exports": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[-a-zA-Z0-9_./]+$"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "contract_families": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "client_profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[-a-zA-Z0-9_./]+$"
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "surface_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
          },
          "kind": {
            "enum": [
              "page",
              "http",
              "scheduled",
              "queue",
              "mcp",
              "native",
              "cli"
            ]
          },
          "entry": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[-a-zA-Z0-9_./]+$"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
            },
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true
          },
          "auth_profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
          }
        },
        "required": [
          "surface_id",
          "kind",
          "entry",
          "operations",
          "auth_profile"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    }
  },
  "required": [
    "format",
    "module_id",
    "owner_role",
    "owned_paths",
    "public_exports",
    "dependencies",
    "contract_families",
    "client_profiles",
    "instructions",
    "invariants",
    "tests",
    "surfaces"
  ],
  "additionalProperties": false
}

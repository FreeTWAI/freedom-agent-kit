{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freetwai.com/contracts/governance/release-set/v1",
  "title": "Freedom release-set development schema",
  "type": "object",
  "properties": {
    "format": {
      "const": "freedom.release-set/v1"
    },
    "digest_profile": {
      "const": "sha256-exact-bytes/v1"
    },
    "release_set_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
    },
    "source_repository": {
      "enum": ["FreeTWAI/freedom-platform", "FreeTWAI-AI/freedom-platform"]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "trust_profile_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._+-]*$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[-a-zA-Z0-9_./]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000000
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1024
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._+-]*$"
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[-a-zA-Z0-9_./]+$"
            },
            "minItems": 1,
            "maxItems": 1024,
            "uniqueItems": true
          }
        },
        "required": [
          "family",
          "version",
          "artifacts"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "library_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._+-]*$"
          },
          "runtime_profiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[-a-zA-Z0-9_./]+$"
            },
            "minItems": 1,
            "maxItems": 1024,
            "uniqueItems": true
          }
        },
        "required": [
          "library_id",
          "version",
          "runtime_profiles",
          "artifacts"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "policy": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._+-]*$"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[-a-zA-Z0-9_./]+$"
          },
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true
        }
      },
      "required": [
        "revision",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._+-]*$"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[-a-zA-Z0-9_./]+$"
          },
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true
        }
      },
      "required": [
        "version",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "fixtures": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._+-]*$"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[-a-zA-Z0-9_./]+$"
          },
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true
        }
      },
      "required": [
        "version",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "format",
    "digest_profile",
    "release_set_id",
    "source_repository",
    "source_commit",
    "trust_profile_version",
    "artifacts",
    "contracts",
    "libraries",
    "policy",
    "generator",
    "fixtures",
    "profiles"
  ],
  "additionalProperties": false
}
